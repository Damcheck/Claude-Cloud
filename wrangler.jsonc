{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-council",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "ai": { "binding": "AI" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-council",
      // Replace with the id printed by `wrangler d1 create ai-council`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Semantic memory. Create with:
  //   wrangler vectorize create ai-council-memory --dimensions=1024 --metric=cosine
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "ai-council-memory" }],

  // Headless Chrome for browser.inspect / browser.test / browser.screenshot.
  "browser": { "binding": "BROWSER" },

  // Isolated Linux sandbox for Cipher and Forge (needs Docker running when you deploy).
  "containers": [{ "class_name": "Sandbox", "image": "./Dockerfile", "max_instances": 3 }],

  // Durable jobs: missions, research, design loop, evals, reflection, model scouting.
  "workflows": [{ "name": "ai-council-jobs", "binding": "JOBS", "class_name": "CouncilJob" }],

  // Runs tools the council writes for itself, each in its own locked-down isolate.
  "worker_loaders": [{ "binding": "LOADER" }],

  // Weekly database backups. Create with: wrangler r2 bucket create ai-council-backups
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "ai-council-backups" }],

  "durable_objects": {
    "bindings": [
      { "name": "COUNCIL_ROOM", "class_name": "CouncilRoom" },
      { "name": "Sandbox", "class_name": "Sandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CouncilRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] }
  ],

  // One tick every 15 minutes drives watchers and all routines (see src/ops/schedule.ts for UTC times).
  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    // Comma-separated Telegram group ids allowed to use the council. Empty = any group.
    "ALLOWED_CHAT_IDS": "",
    // Your Telegram user id(s). Only these people can talk to the council. Empty = anyone.
    "OWNER_USER_IDS": "",
    // The group whose shared memory DMs with individual agents can read (defaults to the first allowed chat).
    "HOME_CHAT_ID": "",
    // Which agent's bot receives group messages and posts system notices.
    "HOST_AGENT": "nexus",
    // AI Gateway id for cost/log dashboards and caching. Empty = direct.
    "AI_GATEWAY_ID": "",
    // Max tokens per agent per UTC day. 0 = unlimited.
    "DAILY_TOKEN_BUDGET_PER_AGENT": "400000",
    // https URL of this Worker, for /call links, e.g. https://ai-council.<you>.workers.dev
    "PUBLIC_URL": "",
    // Optional Mini App link from @BotFather /newapp on the host bot, e.g. https://t.me/NexusCouncilBot/call
    "MINIAPP_URL": "",
    // Repos the GitHub and sandbox skills may touch, e.g. "damcheck/claude-cloud"
    "GITHUB_REPOS": "",
    // MCP connectors, e.g. [{"name":"sentry","url":"https://mcp.sentry.dev/mcp","agents":["forge","cipher"]}]
    // Token secret: MCP_TOKEN_<NAME>. Read-only tools run freely; others ask for approval.
    "MCP_SERVERS": "",
    // Design loop: your store and a development theme id to preview sections on.
    "SHOPIFY_STORE": "",
    "SHOPIFY_THEME_ID": "",
    // Your phone number(s) (E.164) allowed to call the council through Twilio.
    "OWNER_PHONE_NUMBERS": ""
  }

  // Secrets (wrangler secret put <NAME>):
  //   TELEGRAM_WEBHOOK_SECRET
  //   BOT_TOKEN_ATLAS, BOT_TOKEN_NOVA, BOT_TOKEN_SAGE, BOT_TOKEN_NEXUS,
  //   BOT_TOKEN_AXIOM, BOT_TOKEN_CIPHER, BOT_TOKEN_FORGE, BOT_TOKEN_IRIS
  //   FIRECRAWL_API_KEY or BRAVE_API_KEY   (web.search)
  //   GITHUB_TOKEN                          (fine-grained: contents, pull requests, actions read on GITHUB_REPOS)
  //   GITHUB_WEBHOOK_SECRET                 (instant CI-failure alerts: webhook → /github/webhook, event workflow_run)
  //   MCP_TOKEN_<NAME>                      (one per MCP server that needs a bearer token)
  //   SHOPIFY_CLI_THEME_TOKEN               (Theme Access app password, for the design loop)
  //   TWILIO_AUTH_TOKEN                     (phone calls: point your Twilio number's voice webhook at /twilio/voice)
}
